{
  "name": "nuxt-ui-v4-upgrade",
  "version": "1.0.0",
  "description": "Migrate from Nuxt UI Pro to Nuxt UI v4",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "nuxt-ui-v4-upgrade": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "node dist/cli.js nuxt-app --dry-run --verbose"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "fast-glob": "^3.3.2",
    "yaml": "^2.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0"
  },
  "files": [
    "dist/**/*",
    "rules/**/*"
  ],
  "keywords": [
    "nuxt",
    "ui",
    "migration",
    "codemod",
    "upgrade"
  ],
  "author": "hugo@nuxtlabs.com",
  "license": "MIT"
}
