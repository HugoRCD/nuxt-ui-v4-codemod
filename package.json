{
  "name": "nuxt-ui-v4-codemod",
  "version": "1.0.0",
  "description": "Automated migration tool for upgrading from Nuxt UI (and Nuxt UI Pro) to Nuxt UI v4. Provides a smooth transition by handling configuration merging, dependency updates, and breaking changes automatically.",
  "main": "dist/cli.js",
  "type": "module",
  "bin": {
    "nuxt-ui-v4-upgrade": "dist/cli.js",
    "nuxt-ui-migrate": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "nuxt",
    "nuxt-ui",
    "nuxt-ui-pro",
    "migration",
    "codemod",
    "upgrade",
    "v4",
    "automated",
    "vue",
    "typescript"
  ],
  "author": "Hugo Richard",
  "license": "MIT",
  "dependencies": {
    "@ast-grep/napi": "^0.28.1",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "files": [
    "dist",
    "src/rules",
    "README.md",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hugorcd/nuxt-ui-v4-codemod.git"
  },
  "bugs": {
    "url": "https://github.com/hugorcd/nuxt-ui-v4-codemod/issues"
  },
  "homepage": "https://github.com/hugorcd/nuxt-ui-v4-codemod#readme"
}
